apiVersion: v1
kind: Service
metadata:
  name: sonarr-external
  namespace: cilium
  labels:
    app.kubernetes.io/name: sonarr
spec:
  ports:
    - port: 30113
      targetPort: 30113
      protocol: TCP
      name: http
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: sonarr-external-1
  namespace: cilium
  labels:
    app.kubernetes.io/name: sonarr
    kubernetes.io/service-name: sonarr-external
    endpointslice.kubernetes.io/managed-by: argocd
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: 30113
endpoints:
  - addresses:
      - 192.168.0.129
    conditions: {}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: sonarr
  namespace: cilium
spec:
  parentRefs:
    - name: public
      sectionName: https
  hostnames:
    - sonarr.hauptmann.dev
  rules:
    - backendRefs:
        - name: sonarr-external
          port: 30113
