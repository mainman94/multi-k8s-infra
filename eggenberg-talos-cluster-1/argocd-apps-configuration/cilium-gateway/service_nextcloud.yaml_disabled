apiVersion: v1
kind: Service
metadata:
  name: nextcloud-external
  namespace: cilium
  labels:
    app.kubernetes.io/name: nextcloud
spec:
  ports:
    - port: 30056
      targetPort: 30056
      protocol: TCP
      name: http
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: nextcloud-external-1
  namespace: cilium
  labels:
    app.kubernetes.io/name: nextcloud
    kubernetes.io/service-name: nextcloud-external
    endpointslice.kubernetes.io/managed-by: argocd
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: 30056
endpoints:
  - addresses:
      - 192.168.0.129
    conditions: {}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: nextcloud
  namespace: cilium
spec:
  parentRefs:
    - name: public
      sectionName: https
  hostnames:
    - nc.hauptmann.dev
  rules:
    - backendRefs:
        - name: nextcloud-external
          port: 30056
