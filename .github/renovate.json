{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "rebaseWhen": "behind-base-branch",
  "argocd": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "pre-commit": {
    "enabled": true
  }
}
