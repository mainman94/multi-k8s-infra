{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "rebaseWhen": "behind-base-branch",
  "argocd": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "CNPG Cluster spec.imageName (not matched by the kubernetes manager)",
      "managerFilePatterns": [
        "**/*.yaml"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^:\\s@]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "postgres-major"
      ]
    },
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Kargo promotes the pmhme chart through dev, test and prod; a Renovate PR would race it.",
      "matchPackageNames": [
        "ghcr.io/mainman94/charts/pmhme"
      ],
      "enabled": false
    },
    {
      "description": "OCI repoURL already ends in the chart name, so the argocd manager appends it twice.",
      "matchPackageNames": [
        "ghcr.io/spegel-org/helm-charts/spegel/spegel"
      ],
      "overridePackageName": "ghcr.io/spegel-org/helm-charts/spegel"
    }
  ]
}
