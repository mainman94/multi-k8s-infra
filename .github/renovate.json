{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "rebaseWhen": "behind-base-branch",
  "argocd": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "**/*.yaml"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "CNPG Cluster spec.imageName (not matched by the kubernetes manager)",
      "managerFilePatterns": [
        "**/*.yaml"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^:\\s@]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Kustomize remote bases pinned to a commit SHA with the tag in a trailing comment (the kustomize manager only reads ?ref= as a version)",
      "managerFilePatterns": [
        "**/kustomization.yaml"
      ],
      "matchStrings": [
        "github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)//[^?\\s]*\\?ref=(?<currentDigest>[a-f0-9]{40})\\s*#\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "postgres-major"
      ]
    },
    {
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Kargo promotes the pmhme chart through dev, test and prod; a Renovate PR would race it.",
      "matchPackageNames": [
        "ghcr.io/mainman94/charts/pmhme"
      ],
      "enabled": false
    },
    {
      "description": "OCI repoURL already ends in the chart name, so the argocd manager appends it twice.",
      "matchPackageNames": [
        "ghcr.io/spegel-org/helm-charts/spegel/spegel"
      ],
      "overridePackageName": "ghcr.io/spegel-org/helm-charts/spegel"
    },
    {
      "description": "SHA-pinned remote base, bumped by the regex manager above; the kustomize manager would read the SHA as a version.",
      "matchManagers": [
        "kustomize"
      ],
      "matchDepNames": [
        "keycloak/keycloak-k8s-resources"
      ],
      "enabled": false
    }
  ]
}
