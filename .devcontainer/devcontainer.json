{
  "name": "multi-k8s-infra",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // helm only: kubectl (which carries kustomize, what the repo builds
    // with), kube-linter, kubeconform, python, pre-commit, actionlint,
    // shellcheck and trivy are pinned in mise.toml and installed by
    // post-create — the same file CI installs from.
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "none",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "timonwong.shellcheck"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        // yamlfmt owns YAML formatting; the editor's formatter disagrees with it.
        "yaml.format.enable": false
      }
    }
  }
}
